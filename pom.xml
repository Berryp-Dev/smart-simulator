<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <scm>
        <connection>scm:git:https://bk-smartsale.pl.s2-eu.capgemini.com/gitlab/smart-sales/smart-simulator.git
        </connection>
        <developerConnection>
            scm:git:https://bk-smartsale.pl.s2-eu.capgemini.com/gitlab/smart-sales/smart-simulator.git
        </developerConnection>
        <url>scm:https://bk-smartsale.pl.s2-eu.capgemini.com/gitlab/smart-sales/smart-simulator.git</url>
        <tag>HEAD</tag>
    </scm>


    <distributionManagement>
        <repository>
            <id>nexus</id>
            <url>http://nexus3-core:8081/nexus3/repository/smart-sales-maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <url>http://nexus3-core:8081/nexus3/repository/smart-sales-maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <groupId>com.capgemini.smart.simulator</groupId>
    <artifactId>smart-simulator-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SmartSimulator</name>
    <description>
        Piattaforma per la simulazione di sistemi esterni (REST/SOAP),
        con pubblicazione eventi su Kafka e invio messaggi su IBM MQ.
        Ogni sottosistema replicato (Paperless, RaccordoPartitarioConti, ecc.)
        e' un modulo Maven separato che dipende da smart-simulator-core.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.3.4</spring-boot.version>
        <cxf.version>4.0.5</cxf.version>
        <ibm-mq.version>3.3.1</ibm-mq.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.cxf</groupId>
                <artifactId>cxf-spring-boot-starter-jaxws</artifactId>
                <version>${cxf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ibm.mq</groupId>
                <artifactId>mq-jms-spring-boot-starter</artifactId>
                <version>${ibm-mq.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>smart-simulator-core</module>
        <module>smart-simulator-paperless</module>
        <module>smart-simulator-document-viewer</module>
        <module>smart-simulator-raccordo-partitario-conti</module>
        <module>smart-simulator-app</module>
    </modules>

</project>
