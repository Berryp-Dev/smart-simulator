<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.capgemini.smart.simulator</groupId>
        <artifactId>smart-simulator-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>smart-simulator-account-raccordo-partitario</artifactId>
    <packaging>jar</packaging>

    <name>SmartSimulator :: Account Raccordo Partitario</name>
    <description>
        Modulo sottosistema Account Raccordo Partitario: interfacce REST
        autogenerate dagli YAML OpenAPI in smart-simulator-app (REPLICA ORIGINALE),
        servizi inizialmente non implementati (HTTP 501).
    </description>

    <properties>
        <!-- Directory degli YAML OpenAPI (unica fonte del contratto), nell'app -->
        <openapi.dir>${project.basedir}/../smart-simulator-app/src/main/resources/openapi/account-raccordo-partitario</openapi.dir>
        <base.package>com.capgemini.smart.simulator.account.raccordopartitario</base.package>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.capgemini.smart.simulator</groupId>
            <artifactId>smart-simulator-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Richiesta dal codice generato (openApiNullable); swagger-annotations
             e validation arrivano dal core (springdoc, starter-validation) -->
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>0.2.6</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Il default di Maven (2.12.4) non esegue i test JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-sales</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${openapi.dir}/raccordopartitario_sales.yaml</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/sales</output>
                            <generatorName>spring</generatorName>
                            <templateDirectory>${project.basedir}/src/main/openapi-templates</templateDirectory>
                            <apiPackage>${base.package}.sales.adapter.in.rest.api</apiPackage>
                            <modelPackage>${base.package}.sales.adapter.in.rest.model</modelPackage>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <useBeanValidation>true</useBeanValidation>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-currentaccount-configure</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${openapi.dir}/raccordopartitario_sales_currentaccounts_configure.yaml</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/currentaccount-configure</output>
                            <generatorName>spring</generatorName>
                            <templateDirectory>${project.basedir}/src/main/openapi-templates</templateDirectory>
                            <apiPackage>${base.package}.currentaccount.configure.adapter.in.rest.api</apiPackage>
                            <modelPackage>${base.package}.currentaccount.configure.adapter.in.rest.model</modelPackage>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <useBeanValidation>true</useBeanValidation>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
